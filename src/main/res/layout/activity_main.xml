<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Udhaardaar"
        android:textSize="32sp"
        android:textStyle="bold"
        android:gravity="center"
        android:layout_marginBottom="8dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Digital Credit &amp; Repayment Tracker"
        android:textSize="16sp"
        android:gravity="center"
        android:layout_marginBottom="32dp" />

    <Button
        android:id="@+id/btnAddCredit"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Add New Credit"
        android:layout_marginBottom="16dp" />

    <Button
        android:id="@+id/btnMyCredits"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="My Credits"
        android:layout_marginBottom="16dp" />

    <Button
        android:id="@+id/btnPayments"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Payments &amp; Reminders"
        android:layout_marginBottom="16dp" />

    <Button
        android:id="@+id/btnProfile"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="My Profile" />

</LinearLayout>
