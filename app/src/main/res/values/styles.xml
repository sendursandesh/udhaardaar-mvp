<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Udhaardaar" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="android:fontFamily">sans-serif</item>
        <item name="fontFamily">sans-serif</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:windowBackground">#F6F9FC</item>
        <!-- Android 12+ always shows a system launch screen; keep it minimal so it never masquerades as the login page. -->
        <item name="android:windowSplashScreenBackground">#F6F9FC</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_blank</item>
        <item name="android:windowSplashScreenAnimationDuration">1</item>
        <item name="android:statusBarColor">#F6F9FC</item>
        <item name="android:navigationBarColor">#F6F9FC</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="colorAccent">#2663EB</item>
        <item name="colorPrimary">#2663EB</item>
        <item name="colorPrimaryVariant">#1D4ED8</item>
        <item name="colorSecondary">#009187</item>
    </style>
</resources>
