<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/registerScroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:clipToPadding="false"
    android:background="#F5F7FA"
    android:paddingBottom="180dp"
    android:scrollbars="vertical">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Register Credit" android:textSize="24sp" android:textStyle="bold" android:textColor="#111827" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Complete each section. Only authorised parties can access credit information." android:textSize="14sp" android:textColor="#6B7280" android:layout_marginTop="4dp" android:layout_marginBottom="16dp" />

        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="1  Party &amp; Credit Type" android:textSize="18sp" android:textStyle="bold" android:textColor="#111827" android:layout_marginBottom="8dp" />
        <Spinner android:id="@+id/spinnerCreditType" android:layout_width="match_parent" android:layout_height="52dp" android:layout_marginBottom="8dp" />
        <Spinner android:id="@+id/spinnerDirection" android:layout_width="match_parent" android:layout_height="52dp" android:layout_marginBottom="8dp" />
        <Spinner android:id="@+id/spinnerParty" android:layout_width="match_parent" android:layout_height="52dp" android:layout_marginBottom="10dp" />
        <TextView android:id="@+id/tvHistorySummary" android:layout_width="match_parent" android:layout_height="wrap_content" android:background="#FFFFFF" android:padding="12dp" android:text="Select a borrower/party to view credit history." android:textSize="14sp" android:textColor="#4B5563" android:layout_marginBottom="16dp" />

        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="2  Financial Terms" android:textSize="18sp" android:textStyle="bold" android:textColor="#111827" android:layout_marginBottom="8dp" />
        <EditText android:id="@+id/etCreditAmount" android:layout_width="match_parent" android:layout_height="54dp" android:hint="Principal / credit amount (₹)" android:inputType="numberDecimal" android:imeOptions="actionNext" android:padding="14dp" android:background="#FFFFFF" android:layout_marginBottom="8dp" />
        <EditText android:id="@+id/etInterestRate" android:layout_width="match_parent" android:layout_height="54dp" android:hint="ROI (%)" android:inputType="numberDecimal" android:imeOptions="actionNext" android:padding="14dp" android:background="#FFFFFF" android:layout_marginBottom="8dp" />
        <Spinner android:id="@+id/spinnerRepaymentMethod" android:layout_width="match_parent" android:layout_height="52dp" android:layout_marginBottom="8dp" />
        <Spinner android:id="@+id/spinnerPeriodicity" android:layout_width="match_parent" android:layout_height="52dp" android:layout_marginBottom="8dp" />
        <EditText android:id="@+id/etRepaymentAmount" android:layout_width="match_parent" android:layout_height="54dp" android:hint="Repayment / EMI amount (₹)" android:inputType="numberDecimal" android:imeOptions="actionNext" android:padding="14dp" android:background="#FFFFFF" android:layout_marginBottom="8dp" />
        <TextView android:id="@+id/tvCalculation" android:layout_width="match_parent" android:layout_height="wrap_content" android:background="#FFFFFF" android:padding="12dp" android:textSize="13sp" android:textColor="#4B5563" android:layout_marginBottom="16dp" />

        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="3  Dates &amp; Documents" android:textSize="18sp" android:textStyle="bold" android:textColor="#111827" android:layout_marginBottom="8dp" />
        <EditText android:id="@+id/etCreditStartDate" android:layout_width="match_parent" android:layout_height="54dp" android:hint="Start date" android:focusable="false" android:clickable="true" android:padding="14dp" android:background="#FFFFFF" android:layout_marginBottom="8dp" />
        <EditText android:id="@+id/etCreditEndDate" android:layout_width="match_parent" android:layout_height="54dp" android:hint="End / maturity date (optional)" android:focusable="false" android:clickable="true" android:padding="14dp" android:background="#FFFFFF" android:layout_marginBottom="8dp" />
        <EditText android:id="@+id/etInvoiceNumber" android:layout_width="match_parent" android:layout_height="54dp" android:hint="Invoice number (trade credit)" android:inputType="textCapCharacters" android:imeOptions="actionNext" android:padding="14dp" android:background="#FFFFFF" android:layout_marginBottom="8dp" />
        <TextView android:id="@+id/tvInvoiceStatus" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Attach/scan invoice before final registration when trade credit is selected." android:textSize="13sp" android:textColor="#6B7280" android:layout_marginBottom="16dp" />

        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="4  Consent &amp; Notes" android:textSize="18sp" android:textStyle="bold" android:textColor="#111827" android:layout_marginBottom="8dp" />
        <CheckBox android:id="@+id/cbConsent" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="I confirm that this credit may be recorded and viewed only by authorised parties and that required consent/OTP must be obtained." android:layout_marginBottom="8dp" />
        <EditText android:id="@+id/etCreditNotes" android:layout_width="match_parent" android:layout_height="100dp" android:hint="Notes (optional)" android:gravity="top|start" android:inputType="textMultiLine|textCapSentences" android:padding="14dp" android:background="#FFFFFF" android:layout_marginBottom="14dp" />
        <Button android:id="@+id/btnSaveCreditV3" android:layout_width="match_parent" android:layout_height="56dp" android:text="REVIEW &amp; REGISTER CREDIT" android:textStyle="bold" android:layout_marginBottom="36dp" />
    </LinearLayout>
</ScrollView>