<?xml version="1.0" encoding="utf-8"?>

<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="UDHAARDAAR"
            android:textSize="30sp"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_marginBottom="8dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Your Digital Udhaar Manager"
            android:textSize="16sp"
            android:gravity="center"
            android:layout_marginBottom="28dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Dashboard"
            android:textSize="22sp"
            android:textStyle="bold"
            android:layout_marginBottom="16dp" />

        <TextView
            android:id="@+id/tvToReceive"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="To Receive: ₹0"
            android:textSize="18sp"
            android:padding="16dp"
            android:layout_marginBottom="10dp" />

        <TextView
            android:id="@+id/tvToPay"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="To Pay: ₹0"
            android:textSize="18sp"
            android:padding="16dp"
            android:layout_marginBottom="10dp" />

        <TextView
            android:id="@+id/tvActiveRecords"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Active Records: 0"
            android:textSize="18sp"
            android:padding="16dp"
            android:layout_marginBottom="24dp" />

        <Button
            android:id="@+id/btnAddUdhaar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="ADD NEW UDHAAR"
            android:layout_marginBottom="12dp" />

        <Button
            android:id="@+id/btnViewRecords"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="VIEW RECORDS" />

    </LinearLayout>

</ScrollView>
