<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="true"
        android:label="Udhaardaar"
        android:supportsRtl="true"
        android:theme="@style/Theme.Udhaardaar">

        <!-- V3 Dashboard - App Launch Screen -->
        <activity
            android:name=".DashboardV3Activity"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

        </activity>

        <!-- Existing V2 Main Activity - Preserved -->
        <activity
            android:name=".MainActivity"
            android:exported="false" />

        <!-- Existing V2 Credit Entry -->
        <activity
            android:name=".AddUdhaarActivity"
            android:exported="false" />

        <!-- Existing V2 Records -->
        <activity
            android:name=".RecordsActivity"
            android:exported="false" />

    </application>

</manifest>
