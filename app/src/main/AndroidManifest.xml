<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET"/>
    <uses-permission android:name="android.permission.CAMERA"/>
    <application
        android:name="com.arthsaathi.master.ArthSaathiApp"
        android:allowBackup="false"
        android:label="ArthSaathi"
        android:icon="@drawable/arthsaathi_logo"
        android:roundIcon="@drawable/arthsaathi_logo"
        android:supportsRtl="true"
        android:theme="@style/Theme.ArthSaathi"
        android:usesCleartextTraffic="false">
        <activity android:name="com.arthsaathi.master.ArthSaathiLoginActivity" android:exported="true" android:screenOrientation="portrait" android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <activity android:name="com.arthsaathi.master.ArthSaathiHomeActivity" android:exported="false" android:screenOrientation="portrait"/>
        <activity android:name="com.arthsaathi.master.ArthSaathiModuleActivity" android:exported="false" android:screenOrientation="portrait"/>
    </application>
</manifest>
